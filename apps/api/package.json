{
  "name": "@actionproof/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage.enabled=false",
    "test:live": "tsx src/live-smoke.ts --check-only",
    "bootstrap:testnet": "tsx src/bootstrap-testnet-env.ts",
    "demo:sandbox": "tsx src/demo.ts",
    "demo:live": "tsx src/live-smoke.ts"
  },
  "dependencies": {
    "@actionproof/0g": "workspace:*",
    "@actionproof/core": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "ethers": "6.13.1",
    "fastify": "5.11.3",
    "viem": "2.55.13",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
