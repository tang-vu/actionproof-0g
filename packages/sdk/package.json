{
  "name": "@actionproof/sdk",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src/client.test.ts --coverage.enabled=false"
  },
  "dependencies": {
    "@actionproof/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
