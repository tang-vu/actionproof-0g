{
  "name": "actionproof-0g",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proof before action. A verifiable runtime firewall for autonomous AI-agent transactions on 0G.",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm build:libs && pnpm --parallel --filter @actionproof/api --filter @actionproof/web dev",
    "build:libs": "pnpm --filter @actionproof/core build && pnpm --filter @actionproof/0g build",
    "demo": "pnpm build:libs && pnpm --filter @actionproof/api demo:sandbox",
    "demo:live": "pnpm build:libs && pnpm --filter @actionproof/api demo:live",
    "bootstrap:testnet": "pnpm --filter @actionproof/api bootstrap:testnet",
    "register:agent": "pnpm --filter @actionproof/api register:agent",
    "configure:hosting": "tsx scripts/configure-hosting.ts",
    "state:merge": "tsx scripts/merge-runtime-state.ts",
    "host:build": "pnpm build:libs && pnpm --filter @actionproof/api build && pnpm --filter @actionproof/web build",
    "host:start": "pm2 start ecosystem.config.cjs --env production && pm2 save",
    "host:status": "pm2 list --no-color",
    "host:logs": "pm2 logs actionproof --nostream --lines 100",
    "probe:0g": "pnpm build:libs && tsx scripts/probe-0g.ts",
    "format": "prettier --write . && pnpm --filter @actionproof/contracts format",
    "format:check": "prettier --check . && pnpm --filter @actionproof/contracts format:check",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm build:libs && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:contracts": "pnpm --filter @actionproof/contracts test",
    "test:e2e": "pnpm build:libs && pnpm --filter @actionproof/web test:e2e",
    "test:live": "pnpm build:libs && pnpm --filter @actionproof/api test:live",
    "readiness:live": "pnpm build:libs && pnpm --filter @actionproof/api readiness:live",
    "smoke:compute": "pnpm build:libs && pnpm --filter @actionproof/api smoke:compute",
    "smoke:public": "tsx scripts/public-smoke.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:contracts && pnpm build && pnpm check:secrets && pnpm audit:prod && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0"
  }
}
